<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>4.0.0</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Product>Less3</Product>
		<Description>&lt;3 Less3 is S3-compatible object storage that you can run on your laptop, server, or anywhere you like.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageLicenseUrl></PackageLicenseUrl>
		<PackageProjectUrl>https://github.com/jchristn/less3</PackageProjectUrl>
		<PackageIconUrl></PackageIconUrl>
		<RepositoryUrl>https://github.com/jchristn/less3</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageTags>S3 storage blob object storage rest restful</PackageTags>
		<PackageReleaseNotes>v4.0.0 multi-node scale-out: pluggable distributed lock manager (native Postgres default, optional Clutch), shared-storage data plane, cross-node multipart, cluster membership and leader election, OpenTelemetry instrumentation via Radiant with pre-provisioned Grafana dashboards, and Postgres-by-default in Docker while the native single-node OOBE stays SQLite.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>favicon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<ApplicationIcon>heart.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DocumentationFile>Less3.xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="heart.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Inputty" Version="1.0.13" />
		<PackageReference Include="Padlock" Version="1.0.4" />
		<PackageReference Include="PrettyId" Version="2.0.1" />
		<PackageReference Include="Radiant" Version="0.1.2" />
		<PackageReference Include="S3Server" Version="7.3.1" />
		<PackageReference Include="Watson" Version="7.1.0" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
		<PackageReference Include="SyslogLogging" Version="2.1.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="MySql.Data" Version="9.7.0" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="XmlToPox" Version="1.0.3" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\favicon.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Assets\favicon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\..\README.md" Condition="Exists('..\..\README.md')">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="Assets\favicon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md" Condition="Exists('LICENSE.md')">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="clean.bat">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="clean.sh">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Helpers\" />
	</ItemGroup>

</Project>
