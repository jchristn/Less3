{
  "schemaVersion": 1,
  "project": {
    "name": "less3",
    "displayName": "Less3",
    "packageId": "LatticeAI.Less3",
    "bundleId": "ai.latticetech.less3",
    "tagline": "Less3 is S3-compatible object storage that you can run on your laptop, server, or anywhere you like.",
    "description": "Less3 is an S3-compatible object storage server. It runs as a standalone node with SQLite and local disk, or as a multi-node cluster on PostgreSQL and shared storage, and it supports versioning, ACLs, tags, multipart uploads, and both path-style and virtual-hosted URLs. The installer adds the less3 command, which runs the server in the current folder.",
    "license": "MIT",
    "licenseFile": "LICENSE.md",
    "logo": "assets/logo-1024.png",
    "publisher": "Lattice AI, LLC",
    "publisherUrl": "https://latticetech.ai",
    "maintainer": "Lattice AI, LLC <hello@latticetech.ai>",
    "repo": "https://github.com/jchristn/Less3",
    "homepage": "https://github.com/jchristn/Less3"
  },
  "build": {
    "framework": "net10.0",
    "runtimes": ["win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64"],
    "artifacts": [
      {
        "id": "server",
        "csproj": "src/Less3/Less3.csproj",
        "singleFile": true,
        "assemblyName": "less3",
        "mainExecutable": "less3",
        "executables": ["less3"],
        "pathCommands": ["less3"],
        "removeFromPayload": ["clean.bat", "clean.sh", "Assets"],
        "launcher": {
          "displayName": "Less3",
          "comment": "Run the Less3 S3-compatible object storage server",
          "fileName": "start-less3",
          "dataFolder": "Less3"
        },
        "service": {
          "name": "less3",
          "description": "Less3 S3-compatible object storage",
          "user": "less3",
          "workingDirectory": "/var/lib/less3",
          "requiredFile": "system.json"
        },
        "linuxDependencies": {
          "deb": [
            "libc6",
            "libgcc-s1 | libgcc1",
            "libstdc++6",
            "zlib1g",
            "libssl3t64 | libssl3 | libssl1.1",
            "libicu80 | libicu79 | libicu78 | libicu77 | libicu76 | libicu75 | libicu74 | libicu73 | libicu72 | libicu71 | libicu70 | libicu69 | libicu68 | libicu67 | libicu66",
            "ca-certificates"
          ],
          "debRecommends": ["libgssapi-krb5-2"],
          "rpm": ["glibc", "libgcc", "libstdc++", "zlib", "openssl-libs", "libicu", "ca-certificates"]
        }
      }
    ]
  },
  "destinations": {
    "githubRepo": "jchristn/Less3",
    "githubPagesUrl": "https://jchristn.github.io/Less3",
    "homebrewTapRepo": "",
    "scoopBucketRepo": "jchristn/Less3",
    "wingetPkgsRepo": "microsoft/winget-pkgs",
    "nugetSource": "https://api.nuget.org/v3/index.json"
  },
  "channels": {
    "inno": { "enabled": true, "artifact": "server", "options": { "appId": "7A88C2CB-BE0A-595C-A1B6-132D92004939" } },
    "macos": { "enabled": true, "artifact": "server" },
    "debrpm": { "enabled": true, "artifact": "server" },
    "appimage": { "enabled": true, "artifact": "server" },
    "archive": { "enabled": true, "artifact": "server" },
    "winget": { "enabled": true, "artifact": "server", "options": { "identifier": "LatticeAI.Less3" } },
    "choco": { "enabled": true, "artifact": "server", "options": { "packageName": "less3" } },
    "scoop": { "enabled": true, "artifact": "server", "options": { "manifestName": "less3" } },
    "brew": { "enabled": true, "artifact": "server", "options": { "formulaName": "less3" } },
    "aptyum": { "enabled": true, "artifact": "server" },
    "snap": { "enabled": false, "artifact": "server" },
    "flatpak": { "enabled": false, "artifact": "server" }
  },
  "signing": {
    "macOs": { "vaultRef": "APPLE_DEVELOPER_ID", "notarizeProfileRef": "APPLE_NOTARY_PROFILE", "notarize": true, "isConfigured": false },
    "windows": { "vaultRef": "WINDOWS_CERT_PFX", "passwordRef": "WINDOWS_CERT_PASSWORD", "isConfigured": false },
    "linux": { "vaultRef": "GPG_PRIVATE_KEY", "passwordRef": "GPG_PASSPHRASE", "isConfigured": false }
  },
  "releaseNotes": {
    "source": "CHANGELOG.md",
    "heading": "## [{version}]"
  }
}
