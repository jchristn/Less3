{
  "uid": "less3-api-operations",
  "title": "Less3 - API Operations",
  "tags": ["less3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / sec by operation",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (operation) (rate(less3_api_requests_total[5m]))", "legendFormat": "{{operation}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API errors / sec by operation",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (operation) (rate(less3_api_requests_total{result=~\"client_error|server_error\"}[5m]))", "legendFormat": "{{operation}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 latency by operation (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(less3_api_duration_milliseconds_bucket[5m])))", "legendFormat": "{{operation}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests / sec by surface (s3 / rest / admin)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (surface) (rate(less3_api_requests_total[5m]))", "legendFormat": "{{surface}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Object operation stage p95 latency (ms)",
      "description": "Per-stage timing captured throughout object operation execution: lock acquire, storage read/write, metadata commit, blob delete.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, operation, stage) (rate(less3_object_stage_duration_milliseconds_bucket[5m])))", "legendFormat": "{{operation}} / {{stage}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
