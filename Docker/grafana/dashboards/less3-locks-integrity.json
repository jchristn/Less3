{
  "uid": "less3-locks-integrity",
  "title": "Less3 - Locks & Data Integrity",
  "tags": ["less3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fencing conflicts (should be 0)",
      "description": "A non-zero value means a lock holder was correctly rejected after its lease lapsed - the data-integrity guard firing.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        { "refId": "A", "expr": "sum(less3_locks_fencing_conflicts_total)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Locks acquired / sec by mode",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(less3_locks_acquired_total[5m])) by (mode)", "legendFormat": "{{mode}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lock denials / sec by reason",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(less3_locks_denied_total[5m])) by (reason)", "legendFormat": "{{reason}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fencing conflicts / sec by operation",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(less3_locks_fencing_conflicts_total[5m])) by (operation)", "legendFormat": "{{operation}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Multipart completes / aborts per sec",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(less3_multipart_completes_total[5m]))", "legendFormat": "completes", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "sum(rate(less3_multipart_aborts_total[5m]))", "legendFormat": "aborts", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
